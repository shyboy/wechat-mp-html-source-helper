{
  "manifest_version": 3,
  "name": "WeChat MP HTML Source Helper",
  "version": "0.3.0",
  "description": "为微信公众号后台编辑器提供 HTML 源码导入与读取能力。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
